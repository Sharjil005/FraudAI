# ---- FraudShield AI :: environment template ---------------------------------
# Copy to `.env` (repo root) and adjust. Every value below has a working default
# in app/core/config.py, so the app runs with no .env at all — this file exists
# so you can harden it for a real deployment.
#
#   cp .env.example .env
#
# NOTE: .env is git-ignored. Never commit real secrets.

# ---- Database ---------------------------------------------------------------
# Leave this commented out to use the zero-config SQLite file at
# backend/fraudshield.db (an absolute path resolved from the project root, so it
# works no matter which directory you launch from).
# Uncomment to run against PostgreSQL — if the server cannot be reached, the app
# logs a warning and falls back to SQLite instead of refusing to start.
# DATABASE_URL=postgresql+psycopg://fraudshield:fraudshield@localhost:5432/fraudshield

# ---- Authentication ---------------------------------------------------------
# REQUIRED IN PRODUCTION. When unset, a random key is generated at startup,
# which invalidates every issued token on restart.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Bootstrap accounts -----------------------------------------------------
# Created on first startup (and by `python seed.py`) only if missing.
# CHANGE THESE BEFORE ANY PUBLIC DEPLOYMENT, or set CREATE_BOOTSTRAP_USERS=False
# and create accounts through /api/auth/register instead.
ADMIN_EMAIL=admin@fraudshield.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=FraudShield Admin
DEMO_EMAIL=demo@fraudshield.local
DEMO_PASSWORD=Demo@12345
DEMO_NAME=Demo Analyst
CREATE_BOOTSTRAP_USERS=True

# ---- Uploads ----------------------------------------------------------------
# Defaults to backend/uploads (absolute). Uncomment to relocate.
# UPLOAD_DIRECTORY=/var/lib/fraudshield/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=png,jpg,jpeg,pdf

# ---- Machine learning -------------------------------------------------------
# Defaults to backend/app/ml/artifacts (absolute). Uncomment to relocate.
# MODEL_DIRECTORY=/var/lib/fraudshield/models
# Trains the URL and message classifiers on first boot (~5s) and caches them to
# disk. Set to False to run on the rule engine alone.
TRAIN_MODELS_ON_STARTUP=True

# ---- Runtime ----------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ---- Frontend (Vite) --------------------------------------------------------
# Vite only exposes variables prefixed with VITE_. Leave VITE_API_BASE_URL unset
# to use the relative `/api` path, which works with both the dev-server proxy
# and the nginx reverse proxy in Docker.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_PROXY_TARGET=http://127.0.0.1:8000

# ---- docker compose ---------------------------------------------------------
POSTGRES_DB=fraudshield
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=fraudshield
WEB_PORT=3000
API_PORT=8000
